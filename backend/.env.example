PORT=3001
ANTIGRAVITY_KEY=demo-key
GENERATE_API_DOCS_ON_START=false

# MongoDB catalogs and persistence
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=asaaniyat

# Optional agentic chat/RAG model keys. App works in local demo mode without them.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
CHAT_MAX_TOKENS=550
RAG_TOKEN_BUDGET=450
