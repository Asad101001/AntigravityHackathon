# ── Asaaniyat Mobile — Environment Variables ────────────────────────────────
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real keys.

# ── API Backend ──────────────────────────────────────────────────────────────
# Leave commented for LOCAL TESTING (auto-detects LAN IP via Expo hostUri).
# Uncomment and set for APK/Cloud Run production build:
# EXPO_PUBLIC_API_BASE_URL=https://your-backend.run.app

# ── Google Maps ──────────────────────────────────────────────────────────────
# Required for MapView to render. Get from Google Cloud Console.
# Restrict this key to Android/iOS app fingerprint + Maps SDK only.
EXPO_PUBLIC_MAPS_API_KEY=your_google_maps_api_key_here

# ── Optional: Map defaults ───────────────────────────────────────────────────
# Default center if user location is unavailable (Karachi)
EXPO_PUBLIC_DEFAULT_MAP_LAT=24.8607
EXPO_PUBLIC_DEFAULT_MAP_LNG=67.0104
