{
  "expo": {
    "name": "Asaaniyat",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0E8F46"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.asaaniyat.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Asaaniyat uses your location to find service providers near you.",
        "NSLocationAlwaysUsageDescription": "Asaaniyat uses your location to find service providers near you.",
        "NSMicrophoneUsageDescription": "Asaaniyat uses your microphone for voice-based service requests in English, Urdu, and Roman Urdu."
      }
    },
    "android": {
      "package": "com.asaaniyat.app",
      "googleServicesFile": "./google-services.json",
      "edgeToEdgeEnabled": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0E8F46"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "INTERNET",
        "RECORD_AUDIO",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "b67e9798-3df5-4ee1-b2dd-b9d32e2a817f"
      }
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "minSdkVersion": 24,
            "buildArchs": ["arm64-v8a", "armeabi-v7a"]
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-av",
        {
          "microphonePermission": "Allow Asaaniyat to access your microphone for voice-based service requests."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#0E8F46",
          "defaultChannel": "asaaniyat-service"
        }
      ],
      [
        "react-native-maps",
        {
          "androidGoogleMapsApiKey": "AIzaSyDUlHky64mXWWcSqtGoVv4lJjjubJuIlFE"
        }
      ]
    ]
  }
}
