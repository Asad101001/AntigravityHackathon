{
  "expo": {
    "name": "Asaaniyat Provider",
    "slug": "asaaniyat-provider",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "platforms": ["ios", "android", "web"],
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTabletMode": true,
      "bundleIdentifier": "com.antigravity.asaaniyat.provider"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F172A"
      },
      "package": "com.antigravity.asaaniyat.provider"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "modes": ["foreground"]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "1c828945-8f6b-4835-a1c2-3e2b9c7b5a1f"
      }
    }
  }
}
